# crm-cli configuration file
# Place this file at:
#   - ./crm-cli.yaml  (current directory)
#   - %USERPROFILE%\.config\crm-cli\crm-cli.yaml  (Windows user home)
#
# Environment variables take precedence (CRM_ prefix):
#   CRM_BASE_URL, CRM_TENANT_ID, CRM_USERNAME, CRM_PASSWORD, CRM_AUTH_FLOW

# Dynamics 365 environment URL (required, no trailing slash)
crm_base_url: "https://yourorg.crm.dynamics.com"

# =============================================================================
# OPTION 1: Interactive Flow（推奨 — Intune 管理デバイス向け）
# =============================================================================
# ブラウザを直接開いてサインイン。Windows の WAM (Web Account Manager) 経由で
# デバイスの PRT が使われるため、デバイスコンプライアンスの CA ポリシーを通過。
#
auth_flow: "interactive"
# tenant_id は省略可（省略時は "common" を使用）
# tenant_id: "yourorg.onmicrosoft.com"

# =============================================================================
# OPTION 2: Device Code Flow（アプリ登録不要・ブラウザが別端末でもよい場合）
# =============================================================================
# コードが表示されるので、ブラウザで https://microsoft.com/devicelogin にアクセスして入力。
# Intune管理デバイスではデバイスコンプライアンス CA に引っかかる場合があります。
#
# auth_flow: "device_code"
# tenant_id: "yourorg.onmicrosoft.com"   # optional

# =============================================================================
# OPTION 3: Username / Password（アプリ登録不要・MFA なし環境向け）
# =============================================================================
# MFA が有効なアカウントでは使用不可。
#
# auth_flow: "password"
# username: "yourname@yourorg.onmicrosoft.com"
# password: "your-password"
# tenant_id: "yourorg.onmicrosoft.com"   # optional

# =============================================================================
# OPTION 4: Client Credentials（管理者によるアプリ登録が必要）
# =============================================================================
# サービス間通信向け。Azure AD へのアプリ登録が必要です。
#
# auth_flow: "client_credentials"
# tenant_id: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# client_id: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# client_secret: "your-client-secret"

# Web API version (default: 9.2, usually no need to change)
# api_version: "9.2"
