# crm-cli configuration file
# Place this file at:
#   - ./crm-cli.yaml  (current directory)
#   - ~/.config/crm-cli/crm-cli.yaml  (user home)
#
# Environment variables take precedence over this file.
# All values can be set via env vars with the CRM_ prefix:
#   CRM_TENANT_ID, CRM_CLIENT_ID, CRM_CLIENT_SECRET, CRM_BASE_URL

# Azure AD (Entra ID) settings
tenant_id: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
client_id: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
client_secret: "your-client-secret-here"

# Dynamics 365 environment URL (no trailing slash)
crm_base_url: "https://yourorg.crm.dynamics.com"

# Web API version (default: 9.2)
api_version: "9.2"

# Authentication flow:
#   client_credentials - service-to-service (requires client_secret)
#   device_code        - interactive browser login (no client_secret needed)
auth_flow: "client_credentials"
